{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Readixon",
  "version": "0.1.0",
  "identifier": "com.readixon.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "https://readixon.com"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Readixon - Canlı Edebiyat Ağı",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "theme": "Dark",
        "url": "https://readixon.com"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Readixon",
    "copyright": "© 2026 Readixon. Tüm hakları saklıdır.",
    "category": "Book",
    "shortDescription": "Canlı Edebiyat Ağı ve Dijital Yayıncılık Ekosistemi",
    "longDescription": "Readixon, yazarlar için kurgu ve evren geliştirme stüdyosu, okurlar için interaktif ve yaşayan bir dijital edebiyat ağıdır.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
