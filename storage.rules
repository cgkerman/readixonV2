rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // 1. Okuma İzni: Ziyaretçiler dahil herkes platformdaki kapakları ve görselleri görüntüleyebilir
    match /{allPaths=**} {
      allow read: if true;
    }

    // 2. Sohbet Ses Kayıtları (Chats Audio): Max 15MB, yalnızca geçerli ses formatları
    match /chats/{chatId}/audio/{audioFile} {
      allow create, update: if request.auth != null 
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null;
    }

    // 3. Platform Görselleri (Kapaklar, Avatarlar, Webtoonlar, Duyurular, Çizimler):
    // Giriş yapmış kullanıcı, Max 10MB ve yalnızca güvenli görsel formatları (SVG / HTML XSS engelli)
    match /{allPaths=**} {
      allow create, update: if request.auth != null 
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg', 
          'image/png', 
          'image/webp', 
          'image/gif', 
          'image/avif'
        ];
      allow delete: if request.auth != null;
    }
  }
}
